function plotGeo(app)

    % plotFlightPlanWithTerrain: Overlays a flight plan on a terrain map
    %
    % Inputs:
    % latitudes   - Array of latitudes for the flight plan
    % longitudes  - Array of longitudes for the flight plan
    % originLat   - Latitude of the flight plan's origin
    % originLon   - Longitude of the flight plan's origin
    %
    % Example usage:
    % lat = [51.5074, 51.5075, 51.5076]; 
    % lon = [-0.1278, -0.1279, -0.1280]; 
    % plotFlightPlanWithTerrain(lat, lon, 51.5074, -0.1278);
    
    originLat = app.origin(1);
    originLon = app.origin(2);

    latitudes = app.latlon(:,1);
    longitudes = app.latlon(:,2);

    % Create a figure with geographic axes
    figure;
    % Set the basemap to 'satellite' for terrain display
    geobasemap('satellite');
    % Plot the flight plan on the terrain map
    geoplot(latitudes, longitudes, 'r-', 'LineWidth', 2);
    % Hold on to add other elements if needed
    hold on;
    
    % Plot the origin point for reference
    geoplot(originLat, originLon, 'bo', 'MarkerSize', 10, 'DisplayName', 'Origin');
    % Add title and legend
    title('Flight Plan with Terrain Overlay');
    legend('Flight Plan', 'Location', 'best');




end